# Leave VITE_PEER_HOST unset for the free public PeerJS signaling service
# (the default used by Vercel deployments).
# To use the bundled local/self-hosted PeerServer instead:
VITE_PEER_HOST=127.0.0.1
VITE_PEER_PORT=9000
VITE_PEER_PATH=/peerjs
VITE_PEER_SECURE=false

# Optional TURN relay for restrictive networks. STUN-only remains free but
# cannot guarantee connectivity through every corporate/carrier NAT.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
# Optional when this build is served below a path such as /app/.
# VITE_BASE_PATH=/app/
